<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows 蓝牙适配器的「平台无关」部分：IBleAdapter / IBleConnection 实现、看门狗、状态机、错误映射、广播缓存。
    所有 WinRT 调用都藏在 Platform/ 下的接口后面（真实实现在 ScaleBridge.Windows，目标框架 net8.0-windows10.0.19041.0），
    所以这个项目与它的测试在 Linux / Windows 上都能构建和运行。
  -->
  <PropertyGroup>
    <RootNamespace>ScaleBridge.Windows</RootNamespace>
    <AssemblyName>ScaleBridge.Windows.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScaleBridge.Core\ScaleBridge.Core.csproj" />
    <InternalsVisibleTo Include="ScaleBridge.Windows.Core.Tests" />
    <InternalsVisibleTo Include="ScaleBridge.Windows" />
  </ItemGroup>
</Project>
