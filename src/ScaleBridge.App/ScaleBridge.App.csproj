<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ScaleBridge</AssemblyName>
    <RootNamespace>ScaleBridge.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 绑定走反射：界面文字用 Loc 索引器 [key] 做运行时语言切换，不使用编译绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScaleBridge.Core\ScaleBridge.Core.csproj" />
    <ProjectReference Include="..\ScaleBridge.Data\ScaleBridge.Data.csproj" />
    <ProjectReference Include="..\ScaleBridge.Ble.Fake\ScaleBridge.Ble.Fake.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScaleBridge.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
