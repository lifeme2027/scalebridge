<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinRT 外壳的运行时测试。只有 Windows 上才有 WinRT 可加载：
    非 Windows 系统（Linux CI）只做编译检查，IsTestProject=false，`dotnet test` 会跳过它。
    这些测试不需要蓝牙硬件：映射表是纯函数；适配器测试在「没有蓝牙」的机器上也必须通过（只断言不崩溃、状态合理）。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ScaleBridge.Windows\ScaleBridge.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
